+/* Copyright (C) 2026 by Posit Software, PBC
+ * Licensed under the GNU Affero General Public License, version 3. */
+#import "ServerAdmin.h"
+#include <arpa/inet.h>
+
+NSString *RStudioValidateNetwork(NSString *address, NSString *port)
+{
+   struct in_addr v4;
+   struct in6_addr v6;
+   if (!address.length || (inet_pton(AF_INET, address.UTF8String, &v4) != 1 &&
+       inet_pton(AF_INET6, address.UTF8String, &v6) != 1))
+      return @"Enter a numeric IPv4 or IPv6 address, such as 127.0.0.1, 0.0.0.0 or ::1.";
+   NSCharacterSet *nonDigits = [NSCharacterSet characterSetWithCharactersInString:@"0123456789"].invertedSet;
+   if (port.length == 0 || port.length > 5 || [port rangeOfCharacterFromSet:nonDigits].location != NSNotFound ||
+       port.integerValue < 1 || port.integerValue > 65535)
+      return @"Enter a port between 1 and 65535.";
+   return nil;
+}
+
+
+static NSString *adminPath(void)
+{
+   return [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Contents/Resources/app/bin/rstudio-server"];
+}
+
+static NSString *shellQuote(NSString *value)
+{
+   return [NSString stringWithFormat:@"'%@'", [value stringByReplacingOccurrencesOfString:@"'" withString:@"'\\''"]];
+}
+
+static NSTextField *label(NSView *view, NSString *text, NSRect frame)
+{
+   NSTextField *field = [NSTextField wrappingLabelWithString:text];
+   field.frame = frame;
+   [view addSubview:field];
+   return field;
+}
+
+static NSButton *button(NSView *view, NSString *text, NSRect frame, id target, SEL action)
+{
+   NSButton *control = [NSButton buttonWithTitle:text target:target action:action];
+   control.frame = frame;
+   [view addSubview:control];
+   return control;
+}
+
+static NSWindow *adminWindow(NSString *title, CGFloat height)
+{
+   NSWindow *window = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, 740, height)
+      styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable
+      backing:NSBackingStoreBuffered defer:NO];
+   window.title = title;
+   [window center];
+   return window;
+}
+
+static void showAdminError(NSString *message)
+{
+   NSAlert *alert = [NSAlert new];
+   alert.messageText = @"RStudio Server could not complete the request";
+   alert.informativeText = message;
+   [alert runModal];
+}
+
+@interface ServerAccountsController ()
+@property(strong) NSTextField *username;
+@property(strong) NSTextField *home;
+@property(strong) NSButton *hidden;
+@property(strong) NSPopUpButton *operation;
+@property(strong) NSTextView *commands;
+- (void)openConfiguration:(id)sender;
+@end
+
+@implementation ServerAccountsController
+- (instancetype)init
+{
+   self = [super initWithWindow:adminWindow(@"RStudio Server Admin Info", 660)];
+   if (!self) return nil;
+   NSView *view = self.window.contentView;
+   button(view, @"Open /etc/rstudio in Finder", NSMakeRect(24, 608, 692, 30), self, @selector(openConfiguration:));
+   label(view, @"Create a standard macOS account for RStudio with a private home. Hiding it from the login screen is optional. Run the generated commands in your own Terminal; macOS prompts for passwords there.", NSMakeRect(24, 545, 692, 55));
+   label(view, @"Account name", NSMakeRect(24, 508, 125, 22));
+   self.username = [[NSTextField alloc] initWithFrame:NSMakeRect(155, 505, 285, 26)];
+   self.username.stringValue = @"rstudio_alice";
+   self.username.delegate = self;
+   [view addSubview:self.username];
+   self.hidden = [NSButton checkboxWithTitle:@"Hide from login screen" target:self action:@selector(updateCommands:)];
+   self.hidden.frame = NSMakeRect(460, 505, 255, 26);
+   self.hidden.state = NSControlStateValueOn;
+   [view addSubview:self.hidden];
+   label(view, @"Home directory", NSMakeRect(24, 468, 125, 22));
+   self.home = [[NSTextField alloc] initWithFrame:NSMakeRect(155, 465, 555, 26)];
+   self.home.stringValue = @"/Users/RStudioHomes/rstudio_alice";
+   self.home.delegate = self;
+   [view addSubview:self.home];
+   self.operation = [[NSPopUpButton alloc] initWithFrame:NSMakeRect(20, 420, 295, 30) pullsDown:NO];
+   [self.operation addItemsWithTitles:@[@"Create User", @"Change Visibility", @"Delete User", @"Uninstall Server"]];
+   self.operation.target = self;
+   self.operation.action = @selector(updateCommands:);
+   [view addSubview:self.operation];
+   label(view, @"Use a new home under an existing root-owned storage folder. For external storage, mount an ownership-enabled volume first. Accounts use /usr/bin/false and a 0700 home; login-screen hiding alone does not disable every macOS login mechanism.", NSMakeRect(24, 340, 692, 68));
+   NSScrollView *scroll = [[NSScrollView alloc] initWithFrame:NSMakeRect(24, 72, 692, 255)];
+   scroll.hasVerticalScroller = YES;
+   scroll.hasHorizontalScroller = YES;
+   scroll.borderType = NSBezelBorder;
+   self.commands = [[NSTextView alloc] initWithFrame:scroll.bounds];
+   self.commands.editable = NO;
+   self.commands.richText = NO;
+   self.commands.font = [NSFont monospacedSystemFontOfSize:12 weight:NSFontWeightRegular];
+   self.commands.autoresizingMask = NSViewWidthSizable;
+   scroll.documentView = self.commands;
+   [view addSubview:scroll];
+   button(view, @"Copy Commands", NSMakeRect(490, 23, 225, 32), self, @selector(copyCommands:));
+   label(view, @"Deletion preserves the home and refuses users with running processes.", NSMakeRect(24, 20, 450, 36));
+   [self updateCommands:nil];
+   return self;
+}
+
+- (void)openConfiguration:(id)sender
+{
+   if (![NSWorkspace.sharedWorkspace openURL:[NSURL fileURLWithPath:@"/etc/rstudio" isDirectory:YES]])
+      showAdminError(@"The /etc/rstudio folder is not available. Complete the Server installation first.");
+}
+
+- (void)controlTextDidChange:(NSNotification *)notification { [self updateCommands:nil]; }
+
+- (void)updateCommands:(id)sender
+{
+   NSString *name = self.username.stringValue;
+   NSRegularExpression *pattern = [NSRegularExpression regularExpressionWithPattern:@"^[a-z][a-z0-9_]{0,30}$" options:0 error:nil];
+   NSString *home = self.home.stringValue;
+   NSInteger operation = self.operation.indexOfSelectedItem;
+   self.username.enabled = operation != 3;
+   self.home.enabled = operation == 0;
+   self.hidden.enabled = operation == 0 || operation == 1;
+   if (operation == 3)
+   {
+      self.commands.string = [NSString stringWithFormat:
+         @"# Quit all Server sessions first. Removes the app and installer-owned\n"
+          "# system setup. User accounts/homes and modified config are preserved.\n"
+          "sudo %@\n",
+          shellQuote([NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Contents/Resources/app/bin/uninstall-rstudio-server"])];
+      return;
+   }
+   if ([name rangeOfCharacterFromSet:NSCharacterSet.controlCharacterSet].location != NSNotFound ||
+       [pattern numberOfMatchesInString:name options:0 range:NSMakeRange(0, name.length)] != 1 || (operation == 0 && (
+       !home.isAbsolutePath || [home rangeOfCharacterFromSet:NSCharacterSet.controlCharacterSet].location != NSNotFound ||
+       [home hasSuffix:@"/"] || [@[@".", @".."] containsObject:home.lastPathComponent])))
+   {
+      self.commands.string = @"Enter a lowercase account name beginning with a letter (maximum 31 characters) and an absolute path for a new home directory.";
+      return;
+   }
+   NSString *admin = shellQuote(adminPath());
+   NSString *user = shellQuote(name);
+   NSString *parent = shellQuote(home.stringByDeletingLastPathComponent);
+   NSString *visibility = self.hidden.state == NSControlStateValueOn ? @"--hidden" : @"--visible";
+   if (operation == 1)
+   {
+      self.commands.string = [NSString stringWithFormat:@"sudo %@ set-user-visibility %@ %@\n",
+         admin, user, self.hidden.state == NSControlStateValueOn ? @"hidden" : @"visible"];
+      return;
+   }
+   if (operation == 2)
+   {
+      self.commands.string = [NSString stringWithFormat:
+         @"# Quit this user's RStudio session before deleting its account.\n"
+          "# The home is preserved and made root-owned/private.\n"
+          "sudo %@ delete-user %@\n", admin, user];
+      return;
+   }
+   self.commands.string = [NSString stringWithFormat:
+      @"# Prepare the storage parent once, if it does not exist.\n"
+       "# Mount external volumes first; do not create a missing mount point.\n"
+       "if [ ! -e %@ ]; then sudo /bin/mkdir -m 755 %@; fi\n\n"
+       "# Create the user; Terminal prompts securely for its password.\n"
+       "sudo %@ create-user %@ --home %@ %@\n", parent, parent, admin, user, shellQuote(home), visibility];
+}
+
+- (void)copyCommands:(id)sender
+{
+   [NSPasteboard.generalPasteboard clearContents];
+   [NSPasteboard.generalPasteboard setString:self.commands.string forType:NSPasteboardTypeString];
+}
+@end
diff --git a/src/cpp/server/extras/macos/ServerApp.m b/src/cpp/server/extras/macos/ServerApp.m
new file mode 100644
index 0000000000000000000000000000000000000000..67543edca5dac31ce58196ee39920f35df1bb3d9
--- /dev/null
+++ b/src/cpp/server/extras/macos/ServerApp.m
@@ -0,0 +1,290 @@
+/*
+ * Copyright (C) 2026 by Posit Software, PBC
+ * Licensed under the GNU Affero General Public License, version 3.
+ */
+
+#import <Cocoa/Cocoa.h>
+#import <ServiceManagement/ServiceManagement.h>
+#import "ServerAdmin.h"
+#include <libproc.h>
+#include <stdlib.h>
+#include <stdio.h>
+#include <string.h>
+
+static SMAppService *serverService(void)
+{
+   return [SMAppService daemonServiceWithPlistName:@"com.rstudio.launchd.rserver.plist"];
+}
+
+static BOOL enableService(NSError **error)
+{
+   NSString *serverPath = [NSBundle.mainBundle.bundlePath
+      stringByAppendingPathComponent:@"Contents/Resources/app/bin/rserver"];
+   if (![NSFileManager.defaultManager isExecutableFileAtPath:serverPath])
+   {
+      if (error)
+         *error = [NSError errorWithDomain:@"org.rstudio.RStudioServer" code:1
+            userInfo:@{NSLocalizedDescriptionKey:
+               @"The Server files are missing. Install the complete RStudioServer.app before enabling startup."}];
+      return NO;
+   }
+   if (![NSFileManager.defaultManager fileExistsAtPath:@"/etc/pam.d/rstudio"])
+   {
+      if (error)
+         *error = [NSError errorWithDomain:@"org.rstudio.RStudioServer" code:2
+            userInfo:@{NSLocalizedDescriptionKey:
+               @"Server authentication is not configured. Complete the administrator installation before enabling startup."}];
+      return NO;
+   }
+   SMAppService *service = serverService();
+   if (service.status == SMAppServiceStatusEnabled ||
+       service.status == SMAppServiceStatusRequiresApproval)
+      return YES;
+   return [service registerAndReturnError:error];
+}
+
+static BOOL disableService(NSError **error)
+{
+   SMAppService *service = serverService();
+   if (service.status == SMAppServiceStatusNotRegistered)
+      return YES;
+   return [service unregisterAndReturnError:error];
+}
+
+@interface ServerAppDelegate : NSObject <NSApplicationDelegate>
+@property(strong) NSWindow *window;
+@property(strong) NSTextField *serverStatusLabel;
+@property(strong) NSTextField *startupStatusLabel;
+@property(strong) NSButton *serverButton;
+@property(strong) NSButton *startupButton;
+@property(strong) ServerAccountsController *accountsController;
+@end
+
+@implementation ServerAppDelegate
+
+- (void)refreshStatus
+{
+   NSString *server = [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Contents/Resources/app/bin/rserver"];
+   int size = proc_listallpids(NULL, 0);
+   BOOL running = NO;
+   if (size > 0)
+   {
+      size_t capacity = (size_t)size + 64;
+      pid_t *pids = calloc(capacity, sizeof(pid_t));
+      if (pids)
+      {
+         int count = proc_listallpids(pids, (int)(capacity * sizeof(pid_t)));
+         for (int i = 0; i < count && (size_t)i < capacity; ++i)
+         {
+            char path[PROC_PIDPATHINFO_MAXSIZE];
+            if (proc_pidpath(pids[i], path, sizeof(path)) > 0 &&
+                [server isEqualToString:[NSString stringWithUTF8String:path]])
+            { running = YES; break; }
+         }
+         free(pids);
+      }
+   }
+   self.serverStatusLabel.stringValue = running ? @"RStudio Server Status: Running" : @"RStudio Server Status: Dead";
+   self.serverStatusLabel.textColor = running ? NSColor.systemGreenColor : NSColor.systemRedColor;
+   self.serverButton.title = running ? @"Stop Server" : @"Start Server";
+   BOOL enabled = serverService().status == SMAppServiceStatusEnabled;
+   self.startupStatusLabel.stringValue = enabled ? @"RStudio Server Auto Startup: Enabled" : @"RStudio Server Auto Startup: Disabled";
+   self.startupStatusLabel.textColor = enabled ? NSColor.systemGreenColor : NSColor.systemRedColor;
+   self.startupButton.title = enabled ? @"Disable Auto Startup" : @"Enable Auto Startup";
+}
+
+- (void)toggleServer:(id)sender
+{
+   [self refreshStatus];
+   BOOL running = [self.serverStatusLabel.stringValue hasSuffix:@"Running"];
+   NSString *tool = [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Contents/Resources/app/bin/rstudio-server"];
+   NSString *quoted = [NSString stringWithFormat:@"'%@'", [tool stringByReplacingOccurrencesOfString:@"'" withString:@"'\\''"]];
+   NSString *command = [NSString stringWithFormat:@"%@ %@", quoted, running ? @"stop" : @"start"];
+   command = [command stringByReplacingOccurrencesOfString:@"\\" withString:@"\\\\"];
+   command = [command stringByReplacingOccurrencesOfString:@"\"" withString:@"\\\""];
+   NSAppleScript *script = [[NSAppleScript alloc] initWithSource:[NSString stringWithFormat:
+      @"do shell script \"%@\" with administrator privileges", command]];
+   NSDictionary *error = nil;
+   if (![script executeAndReturnError:&error] && [error[NSAppleScriptErrorNumber] integerValue] != -128)
+      [self showError:[NSError errorWithDomain:@"org.rstudio.RStudioServer" code:3
+         userInfo:@{NSLocalizedDescriptionKey:error[NSAppleScriptErrorMessage] ?: @"Administrator authorization failed."}]];
+   [self refreshStatus];
+}
+
+- (void)toggleStartup:(id)sender
+{
+   if (serverService().status == SMAppServiceStatusEnabled)
+      [self disableStartup:sender];
+   else
+      [self enableStartup:sender];
+}
+
+- (void)showError:(NSError *)error
+{
+   NSAlert *alert = [NSAlert new];
+   alert.messageText = @"RStudio Server could not complete the request";
+   alert.informativeText = error.localizedDescription ?: @"Check the application installation and try again.";
+   [alert runModal];
+}
+
+- (void)enableStartup:(id)sender
+{
+   NSError *error = nil;
+   BOOL enabled = enableService(&error);
+   [self refreshStatus];
+   if (serverService().status == SMAppServiceStatusRequiresApproval)
+   {
+      NSAlert *alert = [NSAlert new];
+      alert.messageText = @"Allow RStudio Server to start in the background";
+      alert.informativeText = @"Open System Settings > Login Items and allow RStudio Server under background items. macOS requires administrator approval before the Server can start, including at boot.";
+      [alert addButtonWithTitle:@"Open System Settings"];
+      [alert addButtonWithTitle:@"Later"];
+      if ([alert runModal] == NSAlertFirstButtonReturn)
+         [SMAppService openSystemSettingsLoginItems];
+   }
+   else if (!enabled)
+      [self showError:error];
+}
+
+- (void)disableStartup:(id)sender
+{
+   NSError *error = nil;
+   if (!disableService(&error))
+      [self showError:error];
+   [self refreshStatus];
+}
+
+- (void)showAccounts:(id)sender
+{
+   if (!self.accountsController) self.accountsController = [ServerAccountsController new];
+   [self.accountsController showWindow:nil];
+}
+
+- (void)applicationDidBecomeActive:(NSNotification *)notification
+{
+   [self refreshStatus];
+}
+
+- (void)applicationDidFinishLaunching:(NSNotification *)notification
+{
+   self.window = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, 560, 220)
+      styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable
+      backing:NSBackingStoreBuffered defer:NO];
+   self.window.title = @"RStudio Server";
+   self.serverStatusLabel = [NSTextField labelWithString:@""];
+   self.serverStatusLabel.frame = NSMakeRect(24, 160, 350, 28);
+   self.serverStatusLabel.font = [NSFont systemFontOfSize:15 weight:NSFontWeightSemibold];
+   [self.window.contentView addSubview:self.serverStatusLabel];
+   self.serverButton = [NSButton buttonWithTitle:@"" target:self action:@selector(toggleServer:)];
+   self.serverButton.frame = NSMakeRect(385, 156, 150, 34);
+   [self.window.contentView addSubview:self.serverButton];
+   self.startupStatusLabel = [NSTextField labelWithString:@""];
+   self.startupStatusLabel.frame = NSMakeRect(24, 105, 350, 28);
+   self.startupStatusLabel.font = [NSFont systemFontOfSize:15 weight:NSFontWeightSemibold];
+   [self.window.contentView addSubview:self.startupStatusLabel];
+   self.startupButton = [NSButton buttonWithTitle:@"" target:self action:@selector(toggleStartup:)];
+   self.startupButton.frame = NSMakeRect(385, 101, 150, 34);
+   [self.window.contentView addSubview:self.startupButton];
+   NSButton *admin = [NSButton buttonWithTitle:@"Admin Info…" target:self action:@selector(showAccounts:)];
+   admin.frame = NSMakeRect(24, 35, 510, 36);
+   [self.window.contentView addSubview:admin];
+   [self refreshStatus];
+   [NSTimer scheduledTimerWithTimeInterval:2.0 target:self selector:@selector(refreshStatus) userInfo:nil repeats:YES];
+   [self.window center];
+   [self.window makeKeyAndOrderFront:nil];
+   [NSApp activateIgnoringOtherApps:YES];
+
+}
+
+- (BOOL)applicationShouldTerminateAfterLastWindowClosed:(NSApplication *)sender
+{
+   return YES;
+}
+@end
+
+static void installMenus(ServerAppDelegate *delegate)
+{
+   NSMenu *menuBar = [NSMenu new];
+   NSMenuItem *applicationItem = [NSMenuItem new];
+   [menuBar addItem:applicationItem];
+   NSMenu *applicationMenu = [[NSMenu alloc] initWithTitle:@"RStudio Server"];
+   [applicationMenu addItemWithTitle:@"About RStudio Server" action:@selector(orderFrontStandardAboutPanel:) keyEquivalent:@""];
+   [applicationMenu addItem:NSMenuItem.separatorItem];
+   [applicationMenu addItemWithTitle:@"Quit RStudio Server" action:@selector(terminate:) keyEquivalent:@"q"];
+   applicationItem.submenu = applicationMenu;
+
+   NSMenuItem *editItem = [NSMenuItem new];
+   NSMenu *editMenu = [[NSMenu alloc] initWithTitle:@"Edit"];
+   [editMenu addItemWithTitle:@"Undo" action:@selector(undo:) keyEquivalent:@"z"];
+   [editMenu addItem:NSMenuItem.separatorItem];
+   [editMenu addItemWithTitle:@"Cut" action:@selector(cut:) keyEquivalent:@"x"];
+   [editMenu addItemWithTitle:@"Copy" action:@selector(copy:) keyEquivalent:@"c"];
+   [editMenu addItemWithTitle:@"Paste" action:@selector(paste:) keyEquivalent:@"v"];
+   [editMenu addItemWithTitle:@"Select All" action:@selector(selectAll:) keyEquivalent:@"a"];
+   editItem.submenu = editMenu;
+   [menuBar addItem:editItem];
+
+   NSMenuItem *helpItem = [NSMenuItem new];
+   NSMenu *helpMenu = [[NSMenu alloc] initWithTitle:@"Help"];
+   NSMenuItem *accounts = [helpMenu addItemWithTitle:@"Admin Info…" action:@selector(showAccounts:) keyEquivalent:@""];
+   accounts.target = delegate;
+   helpItem.submenu = helpMenu;
+   [menuBar addItem:helpItem];
+   NSApp.mainMenu = menuBar;
+   NSApp.helpMenu = helpMenu;
+}
+
+int main(int argc, const char *argv[])
+{
+   @autoreleasepool
+   {
+      if (argc == 4 && strcmp(argv[1], "--validate-network") == 0)
+      {
+         NSString *error = RStudioValidateNetwork([NSString stringWithUTF8String:argv[2]], [NSString stringWithUTF8String:argv[3]]);
+         if (error) fprintf(stderr, "%s\n", error.UTF8String);
+         return error ? 1 : 0;
+      }
+      if (argc == 2)
+      {
+         if (strcmp(argv[1], "--service-status") == 0)
+         {
+            switch (serverService().status)
+            {
+            case SMAppServiceStatusEnabled: puts("enabled"); break;
+            case SMAppServiceStatusRequiresApproval: puts("approval-required"); break;
+            case SMAppServiceStatusNotFound: puts("not-found"); break;
+            default: puts("disabled"); break;
+            }
+            return 0;
+         }
+         NSError *error = nil;
+         BOOL success = NO;
+         if (strcmp(argv[1], "--enable-service") == 0)
+         {
+            success = enableService(&error);
+            if (serverService().status == SMAppServiceStatusRequiresApproval)
+            {
+               fprintf(stderr, "Approve RStudio Server in System Settings > Login Items. Open RStudioServer.app for the settings shortcut.\n");
+               return 3;
+            }
+         }
+         else if (strcmp(argv[1], "--disable-service") == 0)
+            success = disableService(&error);
+         else
+         {
+            fprintf(stderr, "Usage: RStudioServer [--enable-service|--disable-service|--service-status|--validate-network ADDRESS PORT]\n");
+            return 2;
+         }
+         if (!success)
+            fprintf(stderr, "%s\n", error.localizedDescription.UTF8String);
+         return success ? 0 : 1;
+      }
+      NSApplication *app = [NSApplication sharedApplication];
+      app.activationPolicy = NSApplicationActivationPolicyRegular;
+      ServerAppDelegate *delegate = [ServerAppDelegate new];
+      app.delegate = delegate;
+      installMenus(delegate);
+      [app run];
+   }
+   return 0;
+}
