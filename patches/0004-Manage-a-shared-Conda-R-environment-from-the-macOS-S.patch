new file mode 100644
index 0000000000000000000000000000000000000000..7367f5465de9f74792b257c07f41c70faca45422
--- /dev/null
+++ b/dependencies/osx/test-server-conda.py
@@ -0,0 +1,146 @@
+#!/usr/bin/env python3
+"""Shared Conda regressions using temporary files; no service or account changes."""
+from pathlib import Path
+import shlex
+import subprocess
+import tempfile
+import unittest
+
+ROOT = Path(__file__).resolve().parents[2]
+ADMIN = ROOT / "src/cpp/server/extras/admin"
+HELPER = ADMIN / "rstudio-server-conda.mac"
+
+
+class CondaTests(unittest.TestCase):
+    def setUp(self):
+        self.temp = tempfile.TemporaryDirectory(prefix="rstudio-conda-")
+        self.addCleanup(self.temp.cleanup)
+        self.directory = Path(self.temp.name)
+        self.config = self.directory / "config"
+        self.config.mkdir()
+        self.prefix = self.directory / "shared"
+        self.prefix.mkdir()
+
+    def shell(self, body):
+        return subprocess.run(["/bin/bash"], input="source " + shlex.quote(str(HELPER)) + "\n" + body,
+                              capture_output=True, text=True)
+
+    def test_arguments_cannot_become_options_or_shell_code(self):
+        for function, values in (
+            ("validName", ("../base", "-n", "a/b", "a\nb", "")),
+            ("validPath", ("relative", "/a/../b", "/a b", "/a;touch", "/a\nb", "/a/.", "/a%U")),
+            ("validSpec", ("--prefix", "-y", "x;touch", "https://example", "a b", "$(id)")),
+        ):
+            for value in values:
+                with self.subTest(function=function, value=value):
+                    self.assertNotEqual(self.shell(function + " " + shlex.quote(value)).returncode, 0)
+        for value in ("r-base=4.6", "python>=3.14", "r-essentials", "numpy=2.*"):
+            self.assertEqual(self.shell("validSpec " + shlex.quote(value)).returncode, 0)
+
+    def test_switch_and_restore_preserve_other_settings(self):
+        config = self.config / "rserver.conf"
+        original = "# R selection\nauth-none=0\nwww-port=8787\nrsession-which-r=/original/bin/R\n"
+        config.write_text(original)
+        body = f'''
+CONFIG_DIR={shlex.quote(str(self.config))}
+SELECTION="$CONFIG_DIR/shared-conda-prefix"
+SNAPSHOT="$CONFIG_DIR/.shared-conda-original"
+SCRIPT_DIR={shlex.quote(str(self.directory))}
+PREFIX={shlex.quote(str(self.prefix))}
+checkStopped() {{ :; }}
+secureFile() {{ :; }}
+secureDir() {{ :; }}
+validateEnvironment() {{ PREFIX="$1"; }}
+prepareLibrary() {{ :; }}
+touch "$SCRIPT_DIR/rsession-conda"
+chmod +x "$SCRIPT_DIR/rsession-conda"
+selectEnvironment "$PREFIX"
+'''
+        result = self.shell(body)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertIn("rsession-which-r=" + str(self.prefix) + "/bin/R", config.read_text())
+        self.assertEqual((self.config / ".shared-conda-original/rserver.conf").read_text(), original)
+        config.write_text(config.read_text().replace("www-port=8787", "www-port=9999"))
+        # Selecting a second environment must preserve the first original snapshot.
+        result = self.shell(body + '\nuseSystemR\n')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        restored = config.read_text()
+        self.assertIn("rsession-which-r=/original/bin/R", restored)
+        self.assertIn("www-port=9999", restored)
+        self.assertIn("auth-none=0", restored)
+        self.assertNotIn("rsession-path=", restored)
+        self.assertFalse((self.config / "shared-conda-prefix").exists())
+
+    def test_active_environment_cannot_be_modified(self):
+        selected = self.config / "shared-conda-prefix"
+        selected.write_text(str(self.prefix) + "\n")
+        result = self.shell("SELECTION=" + shlex.quote(str(selected)) + "\nPREFIX=" +
+                            shlex.quote(str(self.prefix)) + "\ncheckNotSelected\n")
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("different environment", result.stderr)
+
+    def test_user_owned_r_cannot_be_selected_for_privileged_discovery(self):
+        result = self.shell("secureDir " + shlex.quote(str(self.prefix)))
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("root-owned", result.stderr)
+
+    def test_remove_preserves_packages_outside_deleted_prefix(self):
+        managed = self.directory / "managed"
+        prefix = managed / "shared-r"
+        library = prefix / "lib/R/rstudio-library"
+        library.mkdir(parents=True)
+        (library / "user-package").write_text("keep installed R package")
+        config = self.config / "shared-conda-prefix"
+        result = self.shell("MANAGED_ROOT=" + shlex.quote(str(managed)) + "\n" +
+            "SELECTION=" + shlex.quote(str(config)) + "\n" + '''
+lockSettings() { :; }
+condaTool() { :; }
+managedPrefix() { PREFIX="$MANAGED_ROOT/$1"; }
+checkStopped() { :; }
+runConda() { /bin/rm -rf "$PREFIX"; }
+main remove /opt/conda/bin/conda shared-r --confirm-delete
+''')
+        self.assertEqual(result.returncode, 0, result.stderr)
+        self.assertFalse(prefix.exists())
+        archives = list(managed.glob("shared-r-retained-library.*/rstudio-library/user-package"))
+        self.assertEqual(len(archives), 1)
+        self.assertEqual(archives[0].read_text(), "keep installed R package")
+
+    def test_wrapper_passes_shared_defaults_and_preserves_arguments(self):
+        prefix = self.prefix
+        for name in ("bin", "conda-meta", "lib/R/rstudio-library"):
+            (prefix / name).mkdir(parents=True, exist_ok=True)
+        (prefix / "conda-meta/history").touch()
+        for name in ("R", "python"):
+            path = prefix / "bin" / name
+            path.write_text("#!/bin/sh\nexit 0\n")
+            path.chmod(0o755)
+        selection = self.config / "shared-conda-prefix"
+        selection.write_text(str(prefix) + "\n")
+        wrapper = self.directory / "rsession-conda"
+        wrapper.write_text((ADMIN / "rsession-conda.mac").read_text().replace(
+            "PREFIX_FILE=/etc/rstudio/shared-conda-prefix", "PREFIX_FILE=" + shlex.quote(str(selection))))
+        real = self.directory / "rsession"
+        real.write_text('''#!/bin/bash
+printf '%s\n' "$CONDA_PREFIX" "$R_LIBS_USER" "$R_LIBS" "$RETICULATE_PYTHON" "$PATH"
+printf 'ARG:%s\n' "$@"
+''')
+        real.chmod(0o755)
+        result = subprocess.run(["/bin/bash", str(wrapper), "--user-identity", "test user", "--project=has space"],
+                                text=True, capture_output=True)
+        self.assertEqual(result.returncode, 0, result.stderr)
+        lines = result.stdout.splitlines()
+        self.assertEqual(lines[:4], [str(prefix), str(prefix / "lib/R/rstudio-library"),
+                         str(prefix / "lib/R/rstudio-library"), str(prefix / "bin/python")])
+        self.assertTrue(lines[4].startswith(str(prefix / "bin") + ":"))
+        self.assertIn("ARG:test user", lines)
+        self.assertIn("ARG:--project=has space", lines)
+        self.assertIn("ARG:--r-libs-user=" + str(prefix / "lib/R/rstudio-library"), lines)
+        selection.unlink()
+        result = subprocess.run(["/bin/bash", str(wrapper)], capture_output=True, text=True)
+        self.assertNotEqual(result.returncode, 0)
+        self.assertIn("selection is missing", result.stderr)
+
+
+if __name__ == "__main__":
+    unittest.main(verbosity=2)
