+++ b/src/cpp/server/extras/admin/rsession-conda.mac
@@ -0,0 +1,31 @@
+#!/bin/bash
+# Copyright (C) 2026 by Posit Software, PBC
+# Licensed under the GNU Affero General Public License, version 3.
+# rserver has already switched to the authenticated user's UID before exec.
+set -e
+SCRIPT_DIR=$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")" && /bin/pwd -P)
+PREFIX_FILE=/etc/rstudio/shared-conda-prefix
+[ -f "$PREFIX_FILE" ] && [ ! -L "$PREFIX_FILE" ] || {
+ echo 'The shared Conda selection is missing. Ask the administrator to reapply R Environment settings.' >&2; exit 1
+}
+IFS= read -r CONDA_PREFIX < "$PREFIX_FILE"
+[ -x "$CONDA_PREFIX/bin/R" ] && [ -f "$CONDA_PREFIX/conda-meta/history" ] &&
+ [ -d "$CONDA_PREFIX/lib/R/rstudio-library" ] || {
+ echo 'The selected shared Conda environment is unavailable. Mount its volume or choose another R environment.' >&2; exit 1
+}
+export CONDA_PREFIX
+export CONDA_DEFAULT_ENV="${CONDA_PREFIX##*/}"
+export CONDA_SHLVL=1
+export PATH="$CONDA_PREFIX/bin:${PATH:-/usr/bin:/bin:/usr/sbin:/sbin}"
+export R_LIBS_USER="$CONDA_PREFIX/lib/R/rstudio-library"
+export R_LIBS="$R_LIBS_USER"
+# SIP may remove DYLD variables when launching a system shell. Restore them
+# here, after the UID switch and immediately before exec of the real rsession.
+export DYLD_FALLBACK_LIBRARY_PATH="$CONDA_PREFIX/lib/R/lib:$CONDA_PREFIX/lib:/usr/local/lib:/usr/lib"
+export DYLD_INSERT_LIBRARIES="$CONDA_PREFIX/lib/R/lib/libR.dylib"
+if [ -x "$CONDA_PREFIX/bin/python" ]; then
+ export RETICULATE_PYTHON="$CONDA_PREFIX/bin/python"
+fi
+# Never source activation hooks or user shell profiles as the server/root.
+# exec preserves the PID tracked by rserver. R startup files remain user-owned.
+exec "$SCRIPT_DIR/rsession" "$@" --r-libs-user="$R_LIBS_USER"
diff --git a/src/cpp/server/extras/admin/rstudio-server-conda.mac b/src/cpp/server/extras/admin/rstudio-server-conda.mac
new file mode 100755
index 0000000000000000000000000000000000000000..b3ad9c599f993afe3b77384655ac324c91c280bb
--- /dev/null
+++ b/src/cpp/server/extras/admin/rstudio-server-conda.mac
@@ -0,0 +1,224 @@
+#!/bin/bash
+# Copyright (C) 2026 by Posit Software, PBC
+# Licensed under the GNU Affero General Public License, version 3.
+set -euo pipefail
+export PATH=/usr/bin:/bin:/usr/sbin:/sbin
+umask 022
+SCRIPT_DIR=$(cd "$(/usr/bin/dirname "${BASH_SOURCE[0]}")" && /bin/pwd -P)
+CONFIG_DIR=/etc/rstudio
+MANAGED_ROOT=/Library/RStudioServer/conda-envs
+SELECTION="$CONFIG_DIR/shared-conda-prefix"
+SNAPSHOT="$CONFIG_DIR/.shared-conda-original"
+SERVICE=system/com.rstudio.launchd.rserver
+
+fail() { printf '%s\n' "$*" >&2; return 1; }
+requireRoot() { [ "$EUID" -eq 0 ] || fail 'Run this command with administrator privileges.'; }
+validPath() {
+ [[ "$1" =~ ^/[A-Za-z0-9_./+-]+$ ]] && [[ "$1" != *'/../'* ]] &&
+ [[ "$1" != */.. ]] && [[ "$1" != *'/./'* ]] && [[ "$1" != */. ]] ||
+ fail 'Use an absolute path without whitespace, shell characters, . or ...'
+}
+validName() { [[ "$1" =~ ^[A-Za-z][A-Za-z0-9_-]{0,47}$ ]] || fail 'Use an environment name of 1–48 letters, digits, underscores or hyphens, beginning with a letter.'; }
+validSpec() { [[ "$1" =~ ^[A-Za-z0-9][A-Za-z0-9_.=,+*'<>!'-]*$ ]] || fail "Invalid Conda package specification: $1"; }
+checkStopped() {
+ if /bin/launchctl print "$SERVICE" >/dev/null 2>&1 || /usr/bin/pgrep -x rsession >/dev/null; then
+  fail 'Quit all RStudio Server R sessions and stop the Server before changing R environments.'
+ fi
+}
+secureFile() {
+ [ -f "$1" ] && [ ! -L "$1" ] && [ "$(/usr/bin/stat -f '%u' "$1")" = 0 ] ||
+  { fail "Expected a root-owned regular file: $1"; return 1; }
+ local mode=$(/usr/bin/stat -f '%Lp' "$1")
+ (( (8#$mode & 0022) == 0 )) || fail "File must not be group/world-writable: $1"
+}
+secureDir() {
+ [ -d "$1" ] && [ ! -L "$1" ] && [ "$(/usr/bin/stat -f '%u' "$1")" = 0 ] ||
+  { fail "Expected a root-owned directory: $1"; return 1; }
+ local mode=$(/usr/bin/stat -f '%Lp' "$1")
+ (( (8#$mode & 0022) == 0 )) || fail "Directory must not be group/world-writable: $1"
+}
+lockSettings() {
+ requireRoot
+ secureDir "$CONFIG_DIR"
+ /bin/mkdir -m 700 "$CONFIG_DIR/.conda-lock" 2>/dev/null ||
+  { fail 'Another Conda operation is running. Inspect /etc/rstudio/.conda-lock after an interrupted operation.'; return 1; }
+ trap '/bin/rmdir "$CONFIG_DIR/.conda-lock"' EXIT
+}
+secureAncestry() {
+ local dir
+ dir=$(cd "$1" && /bin/pwd -P)
+ while :; do
+  secureDir "$dir"
+  [ "$dir" = / ] && break
+  dir=$(/usr/bin/dirname "$dir")
+ done
+}
+condaTool() {
+ validPath "$1"
+ [ -x "$1" ] && [ "${1##*/}" = conda ] || { fail 'Select the conda executable inside a Miniforge, Miniconda or Anaconda base installation.'; return 1; }
+ CONDA_TOOL="$1"
+ CONDA_BASE=$(cd "$(/usr/bin/dirname "$1")/.." && /bin/pwd -P)
+ # Administrator-managed base is required before executing it with authority.
+ secureDir "$CONDA_BASE"
+ secureDir "$CONDA_BASE/bin"
+ secureDir "$CONDA_BASE/lib"
+ secureDir "$CONDA_BASE/pkgs"
+ secureFile "$CONDA_BASE/bin/conda"
+}
+runConda() {
+ # Do not load the invoking user's ~/.condarc, plugins or shell initialization.
+ /usr/bin/env -i PATH="$CONDA_BASE/bin:/usr/bin:/bin:/usr/sbin:/sbin" \
+  HOME=/var/root LANG=en_US.UTF-8 CONDARC=/dev/null CONDA_NO_PLUGINS=true \
+  CONDA_PKGS_DIRS="$CONDA_BASE/pkgs" CONDA_ENVS_PATH="$MANAGED_ROOT" \
+  "$CONDA_TOOL" --no-plugins "$@"
+}
+managedPrefix() {
+ validName "$1"
+ PREFIX="$MANAGED_ROOT/$1"
+ secureDir "$MANAGED_ROOT"
+ [ -f "$PREFIX/.rstudio-managed-conda" ] && [ ! -L "$PREFIX" ] ||
+  { fail 'Only environments created by this manager can be modified or deleted.'; return 1; }
+ secureDir "$PREFIX"
+ secureFile "$PREFIX/.rstudio-managed-conda"
+}
+checkNotSelected() {
+ if [ -f "$SELECTION" ] && [ "$(cat "$SELECTION")" = "$PREFIX" ]; then
+  fail 'Select system R or a different environment before modifying or deleting the selected environment.'
+ fi
+}
+validateEnvironment() {
+ validPath "$1"
+ PREFIX=$(cd "$1" && /bin/pwd -P)
+ validPath "$PREFIX"
+ [ "$PREFIX" != / ] && [ -f "$PREFIX/conda-meta/history" ] &&
+ [ -x "$PREFIX/bin/R" ] && [ -f "$PREFIX/lib/R/lib/libR.dylib" ] ||
+  { fail 'Choose a Conda environment containing r-base for macOS arm64.'; return 1; }
+ secureAncestry "$PREFIX"
+ secureDir "$PREFIX/bin"
+ secureDir "$PREFIX/lib"
+ secureDir "$PREFIX/lib/R"
+ secureDir "$PREFIX/lib/R/library"
+ secureDir "$PREFIX/lib/R/etc"
+ secureDir "$PREFIX/lib/R/lib"
+ secureFile "$PREFIX/bin/R"
+ secureFile "$PREFIX/lib/R/lib/libR.dylib"
+ /usr/bin/lipo -verify_arch arm64 "$PREFIX/lib/R/lib/libR.dylib" || return 1
+ # R discovery runs this script before rserver drops privileges. It and the
+ # Conda-managed package library must remain administrator-controlled.
+ local home
+ home=$(/usr/bin/env -i PATH="$PREFIX/bin:/usr/bin:/bin" HOME=/var/empty \
+  R_ENVIRON_USER=/dev/null R_PROFILE_USER=/dev/null "$PREFIX/bin/R" RHOME)
+ [ "$home" = "$PREFIX/lib/R" ] || { fail 'RHOME must resolve to the selected environment/lib/R.'; return 1; }
+}
+prepareLibrary() {
+ local lib="$PREFIX/lib/R/rstudio-library"
+ [ ! -L "$lib" ] || { fail 'Refusing a symlink for the shared R package library.'; return 1; }
+ if [ ! -d "$lib" ]; then /usr/bin/install -d -o root -g wheel -m 755 "$lib"; fi
+ secureDir "$lib"
+ # Inheritable ACLs keep packages installed by one UID writable by the other
+ # users, even when R or a package build applies a restrictive umask.
+ local acl='group:everyone allow list,search,read,write,append,execute,delete_child,readattr,writeattr,readextattr,writeextattr,readsecurity,file_inherit,directory_inherit'
+ /bin/chmod -a "$acl" "$lib" 2>/dev/null || true
+ /bin/chmod +a "$acl" "$lib"
+}
+renderConfig() {
+ /usr/bin/awk '!/^[[:space:]]*(rsession-which-r|rsession-ld-library-path|rsession-path)[[:space:]]*=/' "$1"
+ printf '\nrsession-which-r=%s/bin/R\nrsession-ld-library-path=%s/lib\nrsession-path=%s/rsession-conda\n' "$PREFIX" "$PREFIX" "$SCRIPT_DIR"
+}
+selectEnvironment() {
+ checkStopped
+ validateEnvironment "$1"
+ secureFile "$CONFIG_DIR/rserver.conf"
+ [ ! -L "$SELECTION" ] && [ ! -L "$SNAPSHOT" ] || { fail 'Refusing symlinked Conda configuration.'; return 1; }
+ [ -x "$SCRIPT_DIR/rsession-conda" ] || { fail 'Install the complete app with the Conda session launcher first.'; return 1; }
+ prepareLibrary
+ if [ ! -e "$SNAPSHOT" ]; then
+  /bin/mkdir -m 700 "$SNAPSHOT"
+  /bin/cp -p "$CONFIG_DIR/rserver.conf" "$SNAPSHOT/rserver.conf"
+ else
+  secureDir "$SNAPSHOT"
+  secureFile "$SNAPSHOT/rserver.conf"
+ fi
+ local candidate
+ candidate=$(/usr/bin/mktemp "$CONFIG_DIR/.conda-config.XXXXXX")
+ renderConfig "$CONFIG_DIR/rserver.conf" > "$candidate"
+ /bin/chmod 644 "$candidate"
+ local selectionCandidate
+ selectionCandidate=$(/usr/bin/mktemp "$CONFIG_DIR/.conda-prefix.XXXXXX")
+ printf '%s\n' "$PREFIX" > "$selectionCandidate"
+ /bin/chmod 644 "$selectionCandidate"
+ /bin/mv -f "$selectionCandidate" "$SELECTION"
+ /bin/mv -f "$candidate" "$CONFIG_DIR/rserver.conf"
+ echo "Selected $PREFIX. Start the Server, then start new R sessions."
+}
+useSystemR() {
+ checkStopped
+ if [ ! -e "$SELECTION" ]; then echo 'Shared Conda is already disabled.'; return; fi
+ secureFile "$SELECTION"
+ secureDir "$SNAPSHOT"
+ secureFile "$SNAPSHOT/rserver.conf"
+ secureFile "$CONFIG_DIR/rserver.conf"
+ local candidate
+ candidate=$(/usr/bin/mktemp "$CONFIG_DIR/.conda-config.XXXXXX")
+ # Restore only the three R settings we took over; preserve newer network
+ # settings and all unrelated administrator configuration.
+ /usr/bin/awk '!/^[[:space:]]*(rsession-which-r|rsession-ld-library-path|rsession-path)[[:space:]]*=/' "$CONFIG_DIR/rserver.conf" > "$candidate"
+ /usr/bin/awk '/^[[:space:]]*(rsession-which-r|rsession-ld-library-path|rsession-path)[[:space:]]*=/' "$SNAPSHOT/rserver.conf" >> "$candidate"
+ /bin/chmod 644 "$candidate"
+ /bin/mv -f "$candidate" "$CONFIG_DIR/rserver.conf"
+ /bin/rm "$SELECTION" "$SNAPSHOT/rserver.conf"
+ /bin/rmdir "$SNAPSHOT"
+ echo 'Restored the original R settings and per-user package libraries. Start the Server to apply.'
+}
+main() {
+ case "${1:-}" in
+  status)
+   if [ -f "$SELECTION" ]; then printf 'Shared Conda: '; cat "$SELECTION";
+   else echo 'System R / per-user libraries'; fi; return ;;
+  *) ;;
+ esac
+ lockSettings
+ case "${1:-}" in
+  select) [ "$#" -eq 2 ] || { fail 'Usage: conda select PREFIX'; return 2; }; selectEnvironment "$2" ;;
+  system) [ "$#" -eq 1 ] || { fail 'Usage: conda system'; return 2; }; useSystemR ;;
+  create)
+   [ "$#" -eq 5 ] || { fail 'Usage: conda create CONDA NAME R_VERSION PYTHON_VERSION'; return 2; }
+   condaTool "$2"; validName "$3"
+   [[ "$4" =~ ^[0-9]+(\.[0-9]+){1,2}$ ]] && [[ "$5" =~ ^[0-9]+(\.[0-9]+){1,2}$ ]] || { fail 'Use numeric R and Python versions, such as 4.6 and 3.14.'; return 1; }
+   checkStopped
+   if [ ! -d /Library/RStudioServer ]; then /usr/bin/install -d -o root -g wheel -m 755 /Library/RStudioServer; fi
+   secureDir /Library/RStudioServer
+   if [ ! -d "$MANAGED_ROOT" ]; then /usr/bin/install -d -o root -g wheel -m 755 "$MANAGED_ROOT"; fi
+   secureDir "$MANAGED_ROOT"
+   PREFIX="$MANAGED_ROOT/$3"
+   [ ! -e "$PREFIX" ] && [ ! -L "$PREFIX" ] || { fail 'That environment already exists.'; return 1; }
+   runConda create --yes --solver classic --override-channels --channel conda-forge \
+    --strict-channel-priority --prefix "$PREFIX" "r-base=$4" "python=$5"
+   printf 'RStudio Server managed environment\n' > "$PREFIX/.rstudio-managed-conda"
+   validateEnvironment "$PREFIX"; prepareLibrary
+   echo "Created $PREFIX. Select it to use it for Server sessions." ;;
+  install)
+   [ "$#" -ge 4 ] || { fail 'Usage: conda install CONDA NAME PACKAGE...'; return 2; }
+   condaTool "$2"; managedPrefix "$3"; checkStopped; checkNotSelected
+   shift 3
+   for spec in "$@"; do validSpec "$spec"; done
+   runConda install --yes --solver classic --override-channels --channel conda-forge \
+    --strict-channel-priority --prefix "$PREFIX" "$@"
+   validateEnvironment "$PREFIX" ;;
+  remove)
+   [ "$#" -eq 4 ] && [ "$4" = --confirm-delete ] || { fail 'Explicit --confirm-delete is required.'; return 2; }
+   condaTool "$2"; managedPrefix "$3"; checkStopped; checkNotSelected
+   # Conda may delete the entire prefix, including files it did not install.
+   # Move the library outside the prefix first and retain it even on failure.
+   local_archive=$(/usr/bin/mktemp -d "$MANAGED_ROOT/$3-retained-library.XXXXXX")
+   if [ -d "$PREFIX/lib/R/rstudio-library" ]; then
+    /bin/mv "$PREFIX/lib/R/rstudio-library" "$local_archive/rstudio-library"
+   fi
+   if ! runConda env remove --yes --prefix "$PREFIX"; then
+    fail "Conda removal failed. Shared R packages were retained in $local_archive."; return 1
+   fi
+   echo "Removed Conda environment. Shared R packages were retained in $local_archive." ;;
+  *) fail 'Usage: rstudio-server conda {status|select PREFIX|system|create CONDA NAME R_VERSION PYTHON_VERSION|install CONDA NAME PACKAGE...|remove CONDA NAME --confirm-delete}'; return 2 ;;
+ esac
+}
+if [ "${BASH_SOURCE[0]}" = "$0" ]; then main "$@"; fi
