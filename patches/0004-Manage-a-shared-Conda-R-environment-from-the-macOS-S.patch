diff --git a/src/cpp/server/extras/macos/ServerEnvironment.m b/src/cpp/server/extras/macos/ServerEnvironment.m
new file mode 100644
index 0000000000000000000000000000000000000000..c64820ce282e59b98d8b75cedbb8efab682b7268
--- /dev/null
+++ b/src/cpp/server/extras/macos/ServerEnvironment.m
@@ -0,0 +1,181 @@
+/* Copyright (C) 2026 by Posit Software, PBC
+ * Licensed under the GNU Affero General Public License, version 3. */
+#import "ServerEnvironment.h"
+
+static NSString *quote(NSString *value)
+{
+   return [NSString stringWithFormat:@"'%@'", [value stringByReplacingOccurrencesOfString:@"'" withString:@"'\\''"]];
+}
+
+@interface ServerEnvironmentController ()
+@property(strong) NSTextField *conda;
+@property(strong) NSTextField *prefix;
+@property(strong) NSTextField *name;
+@property(strong) NSTextField *rVersion;
+@property(strong) NSTextField *pythonVersion;
+@property(strong) NSTextField *packages;
+@property(strong) NSTextField *status;
+@property(strong) NSTextView *output;
+@property(strong) NSMutableArray<NSControl *> *actions;
+@property(strong) NSProgressIndicator *progress;
+@property BOOL busy;
+@end
+
+@implementation ServerEnvironmentController
+
+- (NSTextField *)field:(NSString *)value y:(CGFloat)y label:(NSString *)text
+{
+   NSTextField *label = [NSTextField labelWithString:text];
+   label.frame = NSMakeRect(24, y + 3, 160, 22);
+   [self.window.contentView addSubview:label];
+   NSTextField *field = [[NSTextField alloc] initWithFrame:NSMakeRect(190, y, 500, 27)];
+   field.stringValue = value;
+   [self.window.contentView addSubview:field];
+   [self.actions addObject:field];
+   return field;
+}
+
+- (void)addButton:(NSString *)title frame:(NSRect)frame action:(SEL)action
+{
+   NSButton *button = [NSButton buttonWithTitle:title target:self action:action];
+   button.frame = frame;
+   [self.window.contentView addSubview:button];
+   [self.actions addObject:button];
+}
+
+- (instancetype)init
+{
+   NSWindow *window = [[NSWindow alloc] initWithContentRect:NSMakeRect(0, 0, 740, 770)
+      styleMask:NSWindowStyleMaskTitled | NSWindowStyleMaskClosable
+      backing:NSBackingStoreBuffered defer:NO];
+   self = [super initWithWindow:window];
+   if (!self) return nil;
+   window.title = @"RStudio Server R Environment";
+   [window center];
+   self.actions = [NSMutableArray new];
+   self.status = [NSTextField wrappingLabelWithString:@""];
+   self.status.frame = NSMakeRect(24, 700, 690, 50);
+   self.status.font = [NSFont systemFontOfSize:13 weight:NSFontWeightSemibold];
+   [window.contentView addSubview:self.status];
+   NSTextField *info = [NSTextField wrappingLabelWithString:
+      @"Choose one shared R environment for all Server users. Quit every R session and stop the Server before applying changes. Users share installed R packages; Conda and R remain administrator-managed."];
+   info.frame = NSMakeRect(24, 628, 690, 65);
+   [window.contentView addSubview:info];
+   self.conda = [self field:@"/opt/conda/bin/conda" y:590 label:@"Conda executable"];
+   self.prefix = [self field:@"" y:550 label:@"Environment folder"];
+   self.prefix.placeholderString = @"Choose an existing Conda environment containing R";
+   [self addButton:@"Browse…" frame:NSMakeRect(20, 505, 145, 32) action:@selector(browse:)];
+   [self addButton:@"Use Shared Environment" frame:NSMakeRect(170, 505, 255, 32) action:@selector(selectEnvironment:)];
+   [self addButton:@"Use System R" frame:NSMakeRect(435, 505, 255, 32) action:@selector(useSystem:)];
+   self.name = [self field:@"shared-r" y:456 label:@"Managed env name"];
+   self.rVersion = [self field:@"4.6" y:416 label:@"R version"];
+   self.pythonVersion = [self field:@"3.14" y:376 label:@"Python version"];
+   self.packages = [self field:@"r-essentials" y:336 label:@"Conda packages"];
+   self.packages.placeholderString = @"Space-separated package names, optionally with versions";
+   [self addButton:@"Create Environment" frame:NSMakeRect(20, 291, 220, 32) action:@selector(createEnvironment:)];
+   [self addButton:@"Install / Update Packages" frame:NSMakeRect(250, 291, 240, 32) action:@selector(installPackages:)];
+   [self addButton:@"Remove Environment…" frame:NSMakeRect(500, 291, 215, 32) action:@selector(removeEnvironment:)];
+   NSTextField *location = [NSTextField wrappingLabelWithString:
+      @"New environments: /Library/RStudioServer/conda-envs/<name>. Shared R library: <environment>/lib/R/rstudio-library. System R restores your previous settings. Start the Server after applying a selection."];
+   location.frame = NSMakeRect(24, 218, 690, 60);
+   [window.contentView addSubview:location];
+   NSScrollView *scroll = [[NSScrollView alloc] initWithFrame:NSMakeRect(24, 55, 690, 155)];
+   scroll.hasVerticalScroller = YES;
+   scroll.borderType = NSBezelBorder;
+   self.output = [[NSTextView alloc] initWithFrame:scroll.bounds];
+   self.output.editable = NO;
+   self.output.richText = NO;
+   self.output.font = [NSFont monospacedSystemFontOfSize:11 weight:NSFontWeightRegular];
+   self.output.autoresizingMask = NSViewWidthSizable;
+   scroll.documentView = self.output;
+   [window.contentView addSubview:scroll];
+   self.progress = [[NSProgressIndicator alloc] initWithFrame:NSMakeRect(24, 18, 22, 22)];
+   self.progress.style = NSProgressIndicatorStyleSpinning;
+   self.progress.displayedWhenStopped = NO;
+   [window.contentView addSubview:self.progress];
+   [self addButton:@"Refresh" frame:NSMakeRect(570, 14, 145, 30) action:@selector(refresh:)];
+   [self refresh:nil];
+   return self;
+}
+
+- (void)refresh:(id)sender
+{
+   if (self.busy) return;
+   NSString *prefix = [NSString stringWithContentsOfFile:@"/etc/rstudio/shared-conda-prefix"
+      encoding:NSUTF8StringEncoding error:nil];
+   prefix = [prefix stringByTrimmingCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet];
+   self.status.stringValue = prefix.length
+      ? [@"Selected shared Conda environment: " stringByAppendingString:prefix]
+      : @"Shared Conda disabled — original R settings and library defaults apply";
+   if (prefix.length) self.prefix.stringValue = prefix;
+}
+
+- (void)browse:(id)sender
+{
+   NSOpenPanel *panel = [NSOpenPanel openPanel];
+   panel.canChooseDirectories = YES;
+   panel.canChooseFiles = NO;
+   panel.canCreateDirectories = NO;
+   panel.message = @"Select the Conda environment folder containing bin/R and conda-meta.";
+   if ([panel runModal] == NSModalResponseOK) self.prefix.stringValue = panel.URL.path;
+}
+
+- (void)run:(NSArray<NSString *> *)arguments
+{
+   if (self.busy) return;
+   NSString *tool = [NSBundle.mainBundle.bundlePath stringByAppendingPathComponent:@"Contents/Resources/app/bin/rstudio-server-conda"];
+   if (![NSFileManager.defaultManager isExecutableFileAtPath:tool])
+   {
+      self.output.string = @"Install the complete RStudioServer.app before applying system settings. The standalone controller supports UI development only.";
+      return;
+   }
+   NSMutableArray *parts = [NSMutableArray arrayWithObject:quote(tool)];
+   for (NSString *arg in arguments) [parts addObject:quote(arg)];
+   NSString *command = [[parts componentsJoinedByString:@" "] stringByAppendingString:@" 2>&1"];
+   command = [command stringByReplacingOccurrencesOfString:@"\\" withString:@"\\\\"];
+   command = [command stringByReplacingOccurrencesOfString:@"\"" withString:@"\\\""];
+   NSString *source = [NSString stringWithFormat:@"do shell script \"%@\" with administrator privileges", command];
+   self.busy = YES;
+   for (NSControl *action in self.actions) action.enabled = NO;
+   self.output.string = @"Waiting for administrator authorization and Conda to finish. Environment creation or package installation may take several minutes.\n";
+   [self.progress startAnimation:nil];
+   dispatch_async(dispatch_get_global_queue(QOS_CLASS_USER_INITIATED, 0), ^{
+      NSDictionary *error = nil;
+      NSAppleScript *script = [[NSAppleScript alloc] initWithSource:source];
+      NSAppleEventDescriptor *result = [script executeAndReturnError:&error];
+      NSString *message = result.stringValue ?: error[NSAppleScriptErrorMessage] ?: @"The operation did not complete.";
+      dispatch_async(dispatch_get_main_queue(), ^{
+         self.output.string = message;
+         self.busy = NO;
+         for (NSControl *action in self.actions) action.enabled = YES;
+         [self.progress stopAnimation:nil];
+         [self refresh:nil];
+      });
+   });
+}
+
+- (void)selectEnvironment:(id)sender { [self run:@[@"select", self.prefix.stringValue]]; }
+- (void)useSystem:(id)sender { [self run:@[@"system"]]; }
+- (void)createEnvironment:(id)sender
+{
+   self.prefix.stringValue = [@"/Library/RStudioServer/conda-envs" stringByAppendingPathComponent:self.name.stringValue];
+   [self run:@[@"create", self.conda.stringValue, self.name.stringValue, self.rVersion.stringValue, self.pythonVersion.stringValue]];
+}
+- (void)installPackages:(id)sender
+{
+   NSMutableArray *args = [NSMutableArray arrayWithArray:@[@"install", self.conda.stringValue, self.name.stringValue]];
+   for (NSString *spec in [self.packages.stringValue componentsSeparatedByCharactersInSet:NSCharacterSet.whitespaceAndNewlineCharacterSet])
+      if (spec.length) [args addObject:spec];
+   [self run:args];
+}
+- (void)removeEnvironment:(id)sender
+{
+   NSAlert *alert = [NSAlert new];
+   alert.messageText = [NSString stringWithFormat:@"Remove managed environment “%@”?", self.name.stringValue];
+   alert.informativeText = @"This removes its Conda-installed R, Python and other Conda packages. Shared R library files are preserved. Select system R first and stop the Server.";
+   [alert addButtonWithTitle:@"Cancel"];
+   [alert addButtonWithTitle:@"Remove Environment"];
+   if ([alert runModal] == NSAlertSecondButtonReturn)
+      [self run:@[@"remove", self.conda.stringValue, self.name.stringValue, @"--confirm-delete"]];
+}
+@end
