<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple Computer//DTD PLIST 1.0//EN"
        "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
        <key>Label</key>
        <string>com.rstudio.launchd.rserver</string>
        <key>EnvironmentVariables</key>
        <dict>
               <key>LANG</key>
               <string>en_US.UTF-8</string>
               <key>PATH</key>
               <string>/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
        </dict>
        <key>BundleProgram</key>
        <string>Contents/Resources/app/bin/rserver</string>
        <key>ProgramArguments</key>
        <array>
                <string>rserver</string>
                <string>--server-daemonize=0</string>
                <string>--auth-none=0</string>
                <string>--auth-validate-users=1</string>
        </array>
        <key>RunAtLoad</key>
        <true/>
        <key>KeepAlive</key>
        <dict>
                <key>SuccessfulExit</key>
                <false/>
        </dict>
        <key>ThrottleInterval</key>
        <integer>10</integer>
        <key>ProcessType</key>
        <string>Background</string>
</dict>
</plist>
